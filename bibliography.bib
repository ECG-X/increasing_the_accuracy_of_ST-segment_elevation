}


@article{ma_making_2025,
	title = {Making sense of health data of wearables: designing information displays for older wearable users},
	volume = {24},
	issn = {1615-5289, 1615-5297},
	shorttitle = {Making sense of health data of wearables},
	url = {https://link.springer.com/10.1007/s10209-024-01159-2},
	doi = {10.1007/s10209-024-01159-2},
	abstract = {Age-related impairment among older adults impedes them from making sense of wearables data and benefiting from such data, e.g., continuous health monitoring and early diagnosis. Incorporating considerations for both age-related ability declines and characteristics of wearable devices, this study proposed an approach to wearable information display for older people, named UnitDesign, which consists of guidelines from four aspects: data classification, data organization, symbol design, and visualization design. To verify the effectiveness of UnitDesign, a laboratory experiment involving 23 older adults was conducted to compare a smartwatch interface design following UnitDesign and an interface following the current mainstream design (i.e., the reference group). The participants performed information search and interpretation tasks using interfaces in both simple and rich data amount conditions during both sitting and walking. Results showed that in the rich data condition, UnitDesign significantly improved older adults’ efficiency in searching for relevant health information. In tasks involving rich data, the participants using UnitDesign reported higher ratings of information representation and were more satisfied with the interface than the control group did. Overall, UnitDesign was preferred by the majority of the participants. The findings provided implications for designing wearable devices for older people.},
	language = {en},
	number = {2},
	urldate = {2026-01-09},
	journal = {Universal Access in the Information Society},
	author = {Ma, Zhaoyi and Gao, Qin and Yang, Mei},
	month = jun,
	year = {2025},
	pages = {1545--1562},
	file = {PDF:/Users/user/Zotero/storage/L58BYACP/Ma et al. - 2025 - Making sense of health data of wearables designing information displays for older wearable users.pdf:application/pdf},
}


@article{hicks_best_2019,
	title = {Best practices for analyzing large-scale health data from wearables and smartphone apps},
	volume = {2},
	issn = {2398-6352},
	url = {https://www.nature.com/articles/s41746-019-0121-1},
	doi = {10.1038/s41746-019-0121-1},
	abstract = {Abstract
            Smartphone apps and wearable devices for tracking physical activity and other health behaviors have become popular in recent years and provide a largely untapped source of data about health behaviors in the free-living environment. The data are large in scale, collected at low cost in the “wild”, and often recorded in an automatic fashion, providing a powerful complement to traditional surveillance studies and controlled trials. These data are helping to reveal, for example, new insights about environmental and social influences on physical activity. The observational nature of the datasets and collection via commercial devices and apps pose challenges, however, including the potential for measurement, population, and/or selection bias, as well as missing data. In this article, we review insights gleaned from these datasets and propose best practices for addressing the limitations of large-scale data from apps and wearables. Our goal is to enable researchers to effectively harness the data from smartphone apps and wearable devices to better understand what drives physical activity and other health behaviors.},
	language = {en},
	number = {1},
	urldate = {2026-01-09},
	journal = {npj Digital Medicine},
