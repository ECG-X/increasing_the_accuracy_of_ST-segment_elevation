@article{dixit_2020,
  title = {Rapid Development of Visualization Dashboards to Enhance Situation Awareness of {{COVID-19}} Telehealth Initiatives at a Multihospital Healthcare System},
  author = {Dixit, Ram A and Hurst, Stephen and Adams, Katharine T and Boxley, Christian and {Lysen-Hendershot}, Kristi and Bennett, Sonita S and Booker, Ethan and Ratwani, Raj M},
